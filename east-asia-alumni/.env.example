# Local development and Vercel Preview must use the development Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEVELOP_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEVELOP_ANON_KEY

# Local migration and integration-test credentials. Never expose these to the browser.
SUPABASE_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
SUPABASE_DB_PASSWORD=YOUR_DEVELOP_DATABASE_PASSWORD

# Optional: the integration test can fetch this through the Management API instead.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_DEVELOP_SERVICE_ROLE_KEY
